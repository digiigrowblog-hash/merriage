generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////
// ENUMS


enum Frequency {
  NEVER
  SOMETIMES
  OFTEN
}

enum IdVerificationType {
  PAN
  AADHAR
  PASSPORT
}

enum PlanType {
  monthly
  yearly
  carnival_weekly
  Free
}

enum SwipeAction {
  LIKE
  PASS
}

enum MembershipStatus {
  active
  expired
  cancelled
}

//////////////////////
// USER


model User {
  id Int @id @default(autoincrement())

  phone             String    @unique
  phoneOtpHash      String?   @map("phone_otp_hash")
  phoneOtpExpiresAt DateTime? @map("phone_otp_expires_at")
  phoneVerified     Boolean   @default(false) @map("phone_verified")

  email             String    @unique
  emailOtpHash      String?   @map("email_otp_hash")
  emailOtpExpiresAt DateTime? @map("email_otp_expires_at")
  emailVerified     Boolean   @default(false) @map("email_verified")

  name     String
  age      Int
  heightCm Float? @map("height_cm")

  latitude  Float?
  longitude Float?
  city      String

  address Json
  health  Json

  eating      String
  gender      String
  orientation String
  preference  String

  company String?
  jobRole String? @map("job_role")
  salary  Float?

  hobbies String[]
  images  String[]

  religion String
  caste    String

  idVerification       IdVerificationType? @map("id_verification")
  idVerificationRef    String?             @map("id_verification_ref")
  idVerificationStatus String?             @map("id_verification_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  isActive       Boolean   @default(true) @map("is_active")
  isHiddenByUser Boolean   @default(false) @map("is_hidden_by_user")
  lastActiveAt   DateTime? @map("last_active_at")

  //////////////////////
  // RELATIONS
  //////////////////////

  sessions       Session[]
  festivalPasses FestivalPass[]
  memberships    Membership[]
  preferences    Preference?

  swipesGiven    Swipe[] @relation("Swiper")
  swipesReceived Swipe[] @relation("Target")

  @@index([city])
  @@index([latitude, longitude])
  @@map("users")
}

//////////////////////
// SESSION


model Session {
  id               String   @id @default(cuid())
  userId           Int
  refreshTokenHash String   @map("refresh_token_hash")
  userAgent        String?  @map("user_agent")
  ipAddress        String?  @map("ip_address")
  createdAt        DateTime @default(now()) @map("created_at")
  expiresAt        DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

//////////////////////
// FESTIVAL PASS


model FestivalPass {
  id        Int      @id @default(autoincrement())
  userId    Int
  isFree    Boolean  @default(false)
  used      Boolean  @default(false)
  weekOf    DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekOf])
  @@index([weekOf])
  @@map("festival_passes")
}

//////////////////////
// PLAN


model Plan {
  id        Int      @id @default(autoincrement())
  name      String
  planType  PlanType
  price     Float
  duration  Int
  createdAt DateTime @default(now()) @map("created_at")

  memberships Membership[]

  @@map("plans")
}

//////////////////////
// MEMBERSHIP


model Membership {
  id        Int              @id @default(autoincrement())
  userId    Int
  planId    Int
  status    MembershipStatus
  createdAt DateTime         @default(now()) @map("created_at")
  expiresAt DateTime         @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@map("memberships")
}

//////////////////////
// PREFERENCE


model Preference {
  id     Int @id @default(autoincrement())
  userId Int @unique

  minAge        Int?
  maxAge        Int?
  maxDistanceKm Int?

  religion String?
  caste    String?

  isAgeStrict      Boolean @default(false)
  isDistanceStrict Boolean @default(false)
  isReligionStrict Boolean @default(false)
  isCasteStrict    Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("preferences")
}

//////////////////////
// SWIPE
//////////////////////

model Swipe {
  id           Int         @id @default(autoincrement())
  userId       Int
  targetUserId Int
  action       SwipeAction
  createdAt    DateTime    @default(now())

  user       User @relation("Swiper", fields: [userId], references: [id], onDelete: Cascade)
  targetUser User @relation("Target", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([userId, targetUserId])
  @@index([userId])
  @@index([targetUserId])
  @@map("swipes")
}
